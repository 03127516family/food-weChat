.wishbar {
  position: fixed; left: 30rpx; right: 30rpx;
  bottom: calc(env(safe-area-inset-bottom) + 122rpx);
  z-index: 50;
  background: rgba(62, 55, 51, 0.95);
  backdrop-filter: blur(12rpx); -webkit-backdrop-filter: blur(12rpx);
  color: #fff; border-radius: 40rpx;
  padding: 20rpx 24rpx 20rpx 26rpx;
  display: flex; align-items: center; gap: 22rpx;
  box-shadow: 0 32rpx 68rpx rgba(110, 70, 60, 0.4);
  transform: translateY(60rpx) scale(0.96); opacity: 0; pointer-events: none;
  transition: 0.34s cubic-bezier(0.2, 0.85, 0.25, 1);
}
.wishbar.show { transform: none; opacity: 1; pointer-events: auto; }

.avs { display: flex; flex: 0 0 auto; }
.avs .av { width: 64rpx; height: 64rpx; border-radius: 18rpx; border: 4rpx solid #3E3733; margin-left: -20rpx; }
.avs .av:first-child { margin-left: 0; }

.tx { font-size: 26rpx; font-weight: 500; line-height: 1.3; }
.tx .b { color: var(--rose-300); font-weight: 700; }
.tx .small { display: block; font-size: 21rpx; color: rgba(255, 255, 255, 0.62); margin-top: 2rpx; letter-spacing: 0.02em; }

.send {
  margin-left: auto; background: var(--rose-500); color: #fff;
  font-size: 26rpx; font-weight: 600; padding: 18rpx 30rpx; border-radius: 28rpx;
  display: flex; align-items: center; gap: 12rpx; white-space: nowrap;
}
