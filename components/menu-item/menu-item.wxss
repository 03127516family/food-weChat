/* menu-item —— 列表行专属样式；chip/meta/heart/add 来自 shared.wxss */
.ml {
  display: flex; align-items: center; gap: 26rpx;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 36rpx;
  padding: 22rpx;
  box-shadow: var(--shadow-sm);
}
.ml .thumb { width: 148rpx; height: 148rpx; border-radius: 28rpx; flex: 0 0 auto; }
.ml-body { flex: 1; }
.ml-name { font-size: 31rpx; font-weight: 700; }
.ml .metas { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; }
