<!-- menu-item —— 「治愈菜单」整页列表行。点行进详情；+ 加入心愿单；♥ 收藏。 -->
<view class="ml" bindtap="onTap">
  <image class="thumb" src="{{dish.img}}" mode="aspectFill" />
  <view class="ml-body">
    <view class="ml-name">{{dish.name}}</view>
    <view class="metas">
      <text class="chip {{dish.tagType}}">{{dish.tag}}</text>
      <view class="meta">{{dish.time}}分钟</view>
    </view>
  </view>
  <view class="add {{inWish ? 'in' : ''}} {{pressed ? 'pressed' : ''}}" catchtap="onAdd">
    <icon name="{{inWish ? 'check' : 'plus'}}" color="{{C.white}}" size="32" />
  </view>
  <view class="heart {{saved ? 'on' : ''}}" catchtap="onHeart">
    <icon name="heart" color="{{saved ? C.white : C.rose500}}" size="30" />
  </view>
</view>
