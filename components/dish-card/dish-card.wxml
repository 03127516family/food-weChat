<!-- dish-card —— 首页「治愈菜单」三宫格卡。点卡进详情；+ 加入心愿单；♥ 收藏(本地装饰)。 -->
<view class="gcard" bindtap="onTap">
  <view class="gimg">
    <image class="food" src="{{dish.img}}" mode="aspectFill" />
    <view class="add {{inWish ? 'in' : ''}} {{pressed ? 'pressed' : ''}}" catchtap="onAdd">
      <icon name="{{inWish ? 'check' : 'plus'}}" color="{{C.white}}" size="28" />
    </view>
    <view class="heart {{saved ? 'on' : ''}}" catchtap="onHeart">
      <icon name="heart" color="{{saved ? C.white : C.rose500}}" size="26" />
    </view>
    <view class="gtime">{{dish.time}}分钟</view>
  </view>
  <view class="gbody">
    <view class="gname">{{dish.name}}</view>
    <view class="gdesc">{{dish.desc}}</view>
  </view>
</view>
