/* 菜单 menu —— 专属样式（页头 .shop-head / 行 .ml 见 shared.wxss、menu-item） */
.menu-page {
  min-height: 100vh;
  /* 原型 #shop/#menu 右上角暖光 */
  background:
    radial-gradient(840rpx 600rpx at 100% -3%, #F6E4DF 0%, transparent 60%),
    var(--cream);
}

/* 原型 h1 覆盖为 28px（×2=56rpx），区别于 shop-head 默认 60rpx */
.menu-h1 { font-size: 56rpx; }

/* 菜单列表（原型 .menu-list：padding 4px 22px 0 / gap 13px → ×2） */
.menu-list {
  padding: 8rpx 44rpx 0;
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}
