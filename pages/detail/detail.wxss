/* 菜品详情 detail —— 专属样式（.navbar/.nav-ic/.nav-right/.btn/.actionbar/.toast 见 shared.wxss） */
.detail {
  min-height: 100vh;
  background: var(--cream);
}

/* navbar 吸顶（盖在主图上方滚动时保持可见） */
.detail .navbar { position: sticky; top: 0; }

/* ---- 主图 ---- */
.detail-hero { height: 520rpx; position: relative; }
.detail-hero .food { width: 100%; height: 100%; }

/* ---- 内容卡 ---- */
.detail-sheet {
  background: var(--cream);
  border-radius: 52rpx 52rpx 0 0;
  margin-top: -52rpx;
  position: relative;
  z-index: 2;
  padding: 44rpx 44rpx 0;
}
.detail-top {
  display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx;
}
.dish-h2 {
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-weight: 700; font-size: 50rpx;
}
.love {
  display: inline-flex; align-items: center; gap: 12rpx;
  background: var(--rose-100); color: var(--rose-700);
  font-size: 24rpx; font-weight: 600;
  padding: 12rpx 24rpx; border-radius: 40rpx; white-space: nowrap; flex: 0 0 auto;
}
.detail-desc { font-size: 26rpx; color: var(--ink-2); line-height: 1.7; margin-top: 22rpx; }
.detail-desc .b { color: var(--rose-700); font-weight: 500; }

/* ---- 数据卡 ---- */
.stats {
  display: flex; background: var(--surface); border: 1px solid var(--line);
  border-radius: 36rpx; margin-top: 36rpx; padding: 32rpx 0; box-shadow: var(--shadow-sm);
}
.stat {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  position: relative;
}
.stat + .stat::before {
  content: ""; position: absolute; left: 0; top: 12rpx; bottom: 12rpx;
  width: 1px; background: var(--line);
}
.stat .v { font-size: 30rpx; font-weight: 700; white-space: nowrap; }
.stat .k { font-size: 22rpx; color: var(--ink-3); white-space: nowrap; }

/* ---- 食材网格 ---- */
.ing-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22rpx; margin-top: 8rpx; }
.ing {
  display: flex; align-items: center; gap: 22rpx;
  background: var(--surface); border: 1px solid var(--line); border-radius: 30rpx;
  padding: 18rpx 22rpx; position: relative;
}
.ing .thumb { width: 84rpx; height: 84rpx; border-radius: 22rpx; flex: 0 0 auto; }
.ing .nm { font-size: 27rpx; font-weight: 500; }
.ing .qt { font-size: 22rpx; color: var(--ink-3); margin-top: 4rpx; }
.ing .ck {
  position: absolute; top: 18rpx; right: 18rpx; width: 36rpx; height: 36rpx;
  border-radius: 50%; background: var(--sage-600);
  display: flex; align-items: center; justify-content: center;
}
.hint {
  font-size: 23rpx; color: var(--ink-3); margin: 26rpx 4rpx 0;
  display: flex; align-items: center; gap: 12rpx;
}

/* ---- 做法步骤 ---- */
.steps { margin-top: 12rpx; display: flex; flex-direction: column; gap: 24rpx; }
.step {
  display: flex; gap: 26rpx; align-items: center;
  background: var(--surface); border: 1px solid var(--line); border-radius: 32rpx;
  padding: 28rpx 30rpx;
}
.step .no {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  background: var(--rose-100); color: var(--rose-700);
  font-weight: 700; font-size: 26rpx;
  display: flex; align-items: center; justify-content: center; flex: 0 0 auto;
}
.step .tx { flex: 1; font-size: 26rpx; line-height: 1.6; color: var(--ink); }
.step .ic { flex: 0 0 auto; opacity: 0.65; }

/* ---- 底部操作条安全区（非 tab 页，需自带底部安全区留白） ---- */
.actionbar-safe { padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); }
