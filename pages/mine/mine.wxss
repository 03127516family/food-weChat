/* 我的 mine —— 专属样式（page-top/hdr-art/love-banner/toast 见 shared.wxss） */
.mine-page {
  min-height: 100vh; position: relative;
  background:
    radial-gradient(840rpx 600rpx at 100% -3%, #F6E4DF 0%, transparent 60%),
    var(--cream);
}
.mine-art { width: 480rpx; height: 640rpx; }

/* ---- 资料 ---- */
.mine-profile { display: flex; align-items: center; gap: 32rpx; padding: 28rpx 44rpx 0; position: relative; z-index: 1; }
.mine-pf-av { width: 168rpx; height: 168rpx; border-radius: 50%; flex: 0 0 auto; box-shadow: 0 20rpx 44rpx rgba(180, 140, 118, 0.28); }
.mp-name {
  font-family: "Noto Serif SC", "Songti SC", serif; font-weight: 700; font-size: 44rpx; color: var(--ink);
  display: flex; align-items: center; gap: 16rpx;
}
.mp-desc { font-size: 24rpx; color: var(--ink-2); margin-top: 18rpx; line-height: 1.6; max-width: 420rpx; }

/* ---- 统计 ---- */
.mine-stats {
  margin: 36rpx 44rpx 0; background: rgba(255, 252, 248, 0.82);
  border: 1px solid rgba(237, 227, 214, 0.7); border-radius: var(--r-card);
  display: flex; padding: 36rpx 0; box-shadow: var(--shadow); position: relative; z-index: 1;
}
.ms { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 10rpx; position: relative; }
.ms + .ms::before { content: ""; position: absolute; left: 0; top: 20rpx; bottom: 20rpx; width: 1px; background: var(--line); }
.ms-ic { width: 92rpx; height: 92rpx; border-radius: 30rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 10rpx; }
.ms-ic.rose { background: var(--rose-100); }
.ms-ic.sage { background: var(--sage-100); }
.ms-ic.honey { background: var(--honey-100); }
.ms-v { font-family: "Noto Serif SC", "Songti SC", serif; font-size: 46rpx; font-weight: 700; color: var(--ink); }
.ms-k { font-size: 22rpx; color: var(--ink-3); }

/* ---- 订阅提醒（做饭的人授权订阅消息） ---- */
.mine-subscribe {
  margin: 36rpx 44rpx 0; display: flex; align-items: center; gap: 22rpx;
  padding: 30rpx 32rpx; border-radius: var(--r-card);
  background: linear-gradient(135deg, var(--rose-500), #C87E7C); color: #fff;
  box-shadow: 0 20rpx 40rpx rgba(195, 120, 118, 0.3);
}
.mine-subscribe.on { background: var(--sage-100); color: var(--sage-600); box-shadow: none; }
.mine-subscribe .sub-ic {
  width: 76rpx; height: 76rpx; border-radius: 24rpx; flex: 0 0 auto;
  background: rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center;
}
.mine-subscribe.on .sub-ic { background: var(--surface); }
.mine-subscribe .sub-tx { flex: 1; min-width: 0; }
.mine-subscribe .sub-t { font-size: 29rpx; font-weight: 700; }
.mine-subscribe .sub-d { font-size: 21rpx; margin-top: 8rpx; opacity: 0.85; line-height: 1.5; }

/* ---- 菜单行 ---- */
.mine-menu {
  margin: 36rpx 44rpx 0; background: var(--surface); border: 1px solid var(--line);
  border-radius: var(--r-card); box-shadow: var(--shadow-sm); overflow: hidden;
}
.mm-row { display: flex; align-items: center; gap: 28rpx; padding: 30rpx 32rpx; }
.mm-row + .mm-row { border-top: 1px solid var(--line); }
.mm-ic { width: 84rpx; height: 84rpx; border-radius: 26rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; }
.mm-ic.rose { background: var(--rose-100); }
.mm-ic.sage { background: var(--sage-100); }
.mm-ic.honey { background: var(--honey-100); }
.mm-tx { flex: 1; min-width: 0; }
.mm-t { font-size: 31rpx; font-weight: 700; color: var(--ink); }
.mm-d { font-size: 23rpx; color: var(--ink-3); margin-top: 6rpx; }
.mm-row .chev { flex: 0 0 auto; }
